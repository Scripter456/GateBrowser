{
  "name": "gate-browser",
  "version": "0.0.1",
  "description": "GateBrowser - Fast and sleek Chromium-based desktop browser",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win --x64",
    "pack:win-portable": "electron-builder --win portable --x64",
    "pack:win-dir": "electron-builder --win dir --x64",
    "pack:linux": "electron-builder --linux",
    "pack:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "keywords": [
    "browser",
    "chromium",
    "gate-browser",
    "electron"
  ],
  "author": "Scripter456",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gatebrowser.app",
    "productName": "GateBrowser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-standalone.exe"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
